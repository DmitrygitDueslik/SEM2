<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <LocalDebuggerCommandArguments>-in:in.txt</LocalDebuggerCommandArguments>
    <DebuggerFlavor>WindowsLocalDebugger</DebuggerFlavor>
    <LocalDebuggerCommandArgumentsHistory>-in:in.txt -out:o.txt -log:l.txt|-in:in.txt|</LocalDebuggerCommandArgumentsHistory>
    <LocalDebuggerWorkingDirectory>
    </LocalDebuggerWorkingDirectory>
    <LocalDebuggerAttach>false</LocalDebuggerAttach>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|Win32'">
    <LocalDebuggerCommandArguments>-in:in.txt -out:out.txt -log:log.txt</LocalDebuggerCommandArguments>
    <DebuggerFlavor>WindowsLocalDebugger</DebuggerFlavor>
    <LocalDebuggerCommandArgumentsHistory>-in:int.txt -out:out.txt log:in.txt.log|-in:in -out:out.txt -log:log.txt|-in:in -out:out -log:log|-in:in.txt -out:out -log:log|-in:in.txt -out:out.txt -log:log.txt|</LocalDebuggerCommandArgumentsHistory>
    <LocalDebuggerWorkingDirectory></LocalDebuggerWorkingDirectory>
  </PropertyGroup>
</Project>